chroma_db/
*.sqlite3
*.db

# Neo4j data (if running locally)
neo4j_data/

# ============================================
# DOCKER
# ============================================
# Docker volumes and data
docker-data/
*.tar
*.tar.gz

# DO NOT ignore docker-compose.yml - we need this!
# DO NOT ignore Dockerfile - we need this!

